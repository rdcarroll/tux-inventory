{
  "name": "myexpressapp",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "serv": "node app.js",
    "webpack-dev": "cross-env NODE_ENV=development webpack",
    "webpack-production": "cross-env NODE_ENV=production webpack",
    "build-serv-dev": "npm run webpack-dev && node app.js",
    "build-serv-prod": "npm run webpack-prod && node app.js",
    "watch-webpack-dev": "webpack --env=dev --watch --color",
    "watch-webpack-production": "npm run build-production --watch --color",
    "explore": "source-map-explorer dist/app.js dist/app.js.map",
    "copy-images": "copyfiles -f \"Client/src/assets/images/**\" \"dist/images\"",
    "copy-views": "copyfiles -f \"Server/Views/**\" \"dist/views\"",
    "build:clean": "del-cli \"Client/src/**/*.js.map\" \"Client/src/**/*.js\" \"Client/src/**/*.ngsummary.json\" \"Client/src/**/*.metadata.json\" \"Client/src/**/**/*.ngfactory.ts\" \"Client/src/**/*.ngstyle.ts\" \"Client/src/**/*.shim.ts\""
  },
  "dependencies": {
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "express": "~4.16.1",
    "http-errors": "~1.6.3",
    "morgan": "~1.9.1",
    "node-oauth2-server": "2.4.0",
    "@angular/animations": "9.1.4",
    "@angular/cdk": "9.2.2",
    "@angular/common": "9.1.4",
    "@angular/compiler": "9.1.4",
    "@angular/compiler-cli": "9.1.4",
    "@angular/core": "9.1.4",
    "@angular/forms": "9.1.4",
    "@angular/localize": "9.1.4",
    "@angular/material": "9.2.2",
    "@angular/platform-browser": "9.1.4",
    "@angular/platform-browser-dynamic": "9.1.4",
    "@angular/pwa": "0.7.5",
    "@angular/router": "9.1.4",
    "@angular/service-worker": "9.1.4",
    "@fortawesome/angular-fontawesome": "0.6.1",
    "@fortawesome/fontawesome-svg-core": "1.2.32",
    "@fortawesome/free-regular-svg-icons": "5.15.1",
    "@fortawesome/free-solid-svg-icons": "5.15.1",
    "@kolkov/angular-editor": "1.1.2",
    "@ng-bootstrap/ng-bootstrap": "6.1.0",
    "@tinymce/tinymce-angular": "4.2.0",
    "bootstrap": "^4.6.0",
    "chart.js": "2.9.3",
    "core-js": "~2.5",
    "file-saver": "1.3.8",
    "jquery": "^3.5.1",
    "moment": "2.24.0",
    "ngx-moment": "3.5.0",
    "node-htmldiff": "0.9.3",
    "popper.js": "1.16.1",
    "rxjs": "~6.5.5",
    "zone.js": "~0.10.3"
  },
  "devDependencies": {
    "@angular/cli": "^9.1.13",
    "@ngtools/webpack": "9.1.4",
    "@types/chart.js": "2.9.14",
    "@types/core-js": "^2.5.4",
    "@types/file-saver": "1.3.1",
    "@types/jquery": "3.3.13",
    "@types/node": "~10.12",
    "ajv": "6.10.2",
    "angular-router-loader": "0.8.5",
    "angular2-router-loader": "*0.3.5",
    "angular2-template-loader": "^0.6.2",
    "awesome-typescript-loader": "5.2.1",
    "clean-webpack-plugin": "3.0.0",
    "copy-webpack-plugin": "4.5.2",
    "cross-env": "5.2.0",
    "css-loader": "^1.0.0",
    "del-cli": "3.0.0",
    "file-loader": "2.0.0",
    "html-loader": "^0.5.5",
    "html-webpack-plugin": "3.2.0",
    "less": "3.8.1",
    "less-loader": "4.1.0",
    "mini-css-extract-plugin": "0.9.0",
    "node-sass": "^4.14.1",
    "null-loader": "^0.1.1",
    "optimize-css-assets-webpack-plugin": "5.0.3",
    "raw-loader": "^0.5.1",
    "rimraf": "^2.5.2",
    "sass-loader": "^7.1.0",
    "source-map-explorer": "2.0.1",
    "style-loader": "^0.23.1",
    "terser-webpack-plugin": "4.2.3",
    "to-string-loader": "1.1.5",
    "tslib": "^1.14.1",
    "typescript": "3.8.3",
    "uglifyjs-webpack-plugin": "2.2.0",
    "webpack": "^4.46.0",
    "webpack-cli": "^3.3.12",
    "webpack-merge": "^4.1.4"
  }
