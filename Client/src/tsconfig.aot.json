{
  "compilerOptions": {
    "target": "es5",
    "module": "commonjs",
    "moduleResolution": "node",
    "sourceMap": false,
    //"declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "lib": [ "es2015", "dom" ],
    "noImplicitAny": true,
    "suppressImplicitAnyIndexErrors": true,
    "types": [ "node", "jquery" ],
    "typeRoots": [ "../../node_modules/@types" ]
  },
  "compileOnSave": true,
  "files": [
    "main.aot.ts",
    "polyfills.ts",
    "vendor.ts"
  ],
  "include": [
    "./**/*.d.ts"
  ],
  "exclude": [
    "../../node_modules/*",
    "./**/*.spec.ts"
  ]
}