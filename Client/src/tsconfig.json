{
  "compilerOptions": {
    "target": "es5",
    "module": "commonjs",
    "moduleResolution": "node",
    "sourceMap": true,
    //"declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "lib": [ "es2015", "dom" ],
    "noImplicitAny": true,
    "suppressImplicitAnyIndexErrors": true,
    "types": [ "node", "jquery" ],
    "typeRoots": [ "../../node_modules/@types" ]
  },
  "compileOnSave": true,
  "exclude": [
    "../../node_modules/*",
    //"*.aot.ts"
  ]
}